STORAGE_DIR=./storage
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=500
# Video authenticity (DFSpot): checkpoints must exist as <MODELS_DIR>/<dataset>_<v2|v2st|vit|vitst>.pth
AUTHENTICITY_MODELS_DIR=./models
AUTHENTICITY_DATASET=dfdc
AUTHENTICITY_MODELS=["TimmV2"]
AUTHENTICITY_FPV=32
WORKER_THREADS=1
# Configuration page: encrypts secrets saved from the UI (required to save a connection string there)
APP_SECRET_KEY=
# First administrator, created on start-up when there are no users yet (otherwise the first visitor sets one up in the browser).
# Password: at least 10 characters, not containing the username.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Alternative to saving the connection string in the UI
AZURE_STORAGE_CONNECTION_STRING=
# Vital signs from face video (open-rppg). Weights are bundled with the package.
VITALS_ENABLED=true
VITALS_MODEL=FacePhys.rlap
# Age estimation (MiVOLO) - separate virtualenv, see README
AGE_ENABLED=true
AGE_PYTHON=
AGE_MODELS_DIR=./models/age
AGE_FRAMES=8
# Standalone services (services/face_match and services/liveness). Empty URL = test reported as Unavailable.
FACE_MATCH_URL=http://127.0.0.1:8101
FACE_MATCH_API_KEY=
LIVENESS_URL=http://127.0.0.1:8102
LIVENESS_API_KEY=
FACE_MATCH_FRAMES=12
LIVENESS_FRAMES=12

# Azure SQL (all application data); the tables are created in their own schema
SQL_CONNECTION_STRING=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
SQL_SCHEMA=pivc

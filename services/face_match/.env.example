# Required (unless FACE_MATCH_DISABLE_AUTH=true, local development only). Comma separated so keys can be rotated.
FACE_MATCH_API_KEYS=change-me-long-random-string
FACE_MATCH_MATCH_THRESHOLD=0.45
FACE_MATCH_MISMATCH_THRESHOLD=0.28
FACE_MATCH_MAX_IMAGE_MB=10
FACE_MATCH_MAX_VIDEO_MB=500
FACE_MATCH_DEFAULT_FRAMES=12
